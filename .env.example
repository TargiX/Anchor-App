# Anchor backend — self-hosted auth + sync (see docs/backend.md).
# NEXT_PUBLIC_BACKEND_URL marks the deployment as backend-enabled and is the
# absolute URL native builds call directly. BACKEND_URL is the dev-server
# rewrite target (default http://localhost:3000) and the server-side session
# check for /api/anchor-checkins. Production sets both to
# https://api.anchorapp.cc; local dev sets both to the local backend.
NEXT_PUBLIC_BACKEND_URL=
BACKEND_URL=

# PostHog product analytics. Create/select a project, then copy its project
# token and use the matching regional ingestion host (US or EU).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

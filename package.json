{
  "name": "anchor",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "cross-env PORT=3088 next dev --turbopack",
    "build": "next build && node scripts/verify-build.mjs web",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "showcase:capture": "node scripts/capture-showcase.mjs",
    "build:native": "cross-env BUILD_TARGET=native next build && node scripts/verify-build.mjs native",
    "cap:sync": "npm run build:native && cap sync",
    "desktop:dev": "npm run cap:sync && cd electron && npm run electron:start",
    "desktop:pack": "npm run cap:sync && cd electron && npm run electron:pack",
    "desktop:make": "npm run cap:sync && cd electron && npm run electron:make",
    "mobile:add:ios": "npm run build:native && cap add ios",
    "mobile:add:android": "npm run build:native && cap add android",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.4.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.4.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.2.0",
    "@capacitor/status-bar": "8.0.2",
    "@supabase/supabase-js": "^2.106.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.39.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor-community/electron": "^5.0.1",
    "@capacitor/cli": "^8.3.4",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "puppeteer-core": "^25.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.28",
    "baseline-browser-mapping": "^2.11.24",
    "tar": "^7.5.22",
    "@xmldom/xmldom": "^0.9.12",
    "js-yaml": "^4.3.2",
    "browserslist": "4.28.9",
    "@babel/core": "^7.29.7",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "4.13.7",
    "@hono/node-server": "^1.19.17",
    "body-parser": "^2.3.0",
    "ip-address": "10.7.0",
    "qs": "^6.16.0",
    "postcss-selector-parser": "^7.1.6",
    "fast-uri": "3.1.7",
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.12"
    }
  }
}
